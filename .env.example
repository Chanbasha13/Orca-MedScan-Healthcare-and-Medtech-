# Orca MedScan — Environment Configuration
# Copy this file to .env and insert your real Groq API key:
# cp .env.example .env

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Groq Cloud API Configuration (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_placeholder_here
# Recommended models: llama-3.3-70b-versatile, llama-3.1-8b-instant, llama3-70b-8192
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30

